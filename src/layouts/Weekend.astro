---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image="/weekend-social.png" />
    <link rel="icon" type="image/svg+xml" href="/weekend-icon.svg" />
    <meta name="theme-color" content="#07060c" />
  </head>
  <body>
    <a class="home-link" href="/" aria-label="Back to William Kaiser's homepage">WK<span aria-hidden="true">↗</span></a>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; min-height: 100%; background: #07060c; }

  button, a { font: inherit; }

  .home-link {
    position: fixed;
    z-index: 30;
    top: 1.15rem;
    left: 1.15rem;
    display: flex;
    width: 2.65rem;
    height: 2.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 999px;
    background: rgb(7 6 12 / 42%);
    color: #fff8e8;
    font-size: 0.66rem;
    font-weight: 700;
    text-decoration: none;
    backdrop-filter: blur(12px);
  }

  .home-link span { font-size: 0.52rem; }

  .weekend-experience {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100svh;
    min-height: 43rem;
    overflow: hidden;
    background: radial-gradient(circle at center, #221334, #07060c 70%);
    color: #fff9eb;
  }

  .fractal-canvas,
  .fractal-wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .fractal-canvas { z-index: 0; display: block; }

  .fractal-wash {
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(7 6 12 / 58%) 0%, transparent 29%, transparent 72%, rgb(7 6 12 / 68%) 100%),
      radial-gradient(circle at 50% 50%, transparent 0 24%, rgb(6 5 12 / 20%) 62%, rgb(4 3 8 / 62%) 100%);
    pointer-events: none;
  }

  .experience-title {
    position: absolute;
    z-index: 4;
    top: clamp(4.4rem, 7vh, 6rem);
    left: 50%;
    width: min(92vw, 70rem);
    text-align: center;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity 500ms ease, transform 700ms ease;
  }

  .experience-title p {
    margin: 0 0 0.72rem;
    color: rgb(255 249 235 / 62%);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .experience-title h1 {
    margin: 0;
    font-size: clamp(2rem, 4.8vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-shadow: 0 3px 28px rgb(0 0 0 / 35%);
  }

  .is-open .experience-title {
    opacity: 0;
    transform: translate(-50%, -1rem);
  }

  .book-stage {
    position: absolute;
    z-index: 5;
    inset: clamp(6.6rem, 12vh, 8rem) 0 clamp(8.5rem, 16vh, 10rem);
    display: grid;
    place-items: center;
    perspective: 1800px;
    pointer-events: none;
  }

  .book-object {
    position: relative;
    width: min(88vw, 58rem);
    aspect-ratio: 1.62;
    transform: translateX(-25%) rotateX(4deg) rotateZ(-1deg) scale(0.88);
    transform-style: preserve-3d;
    transition: transform 1.05s cubic-bezier(.2, .78, .18, 1);
  }

  .is-open .book-object { transform: translateX(0) rotateX(2deg) rotateZ(0deg) scale(1); }

  .book-spread {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border: clamp(0.55rem, 1.1vw, 0.85rem) solid #080808;
    border-radius: 0.55rem 1rem 1rem 0.55rem;
    background: #f2ebd8;
    box-shadow:
      0 1.7rem 5rem rgb(0 0 0 / 58%),
      0 0 0 1px rgb(235 190 93 / 22%);
    opacity: 0;
    transform: scaleX(0.51) translateZ(-0.1rem);
    transform-origin: center;
    transition: opacity 260ms ease 340ms, transform 900ms cubic-bezier(.2, .78, .18, 1);
  }

  .is-open .book-spread {
    opacity: 1;
    cursor: ew-resize;
    pointer-events: auto;
    touch-action: none;
    transform: scaleX(1) translateZ(0);
  }

  .turning-sheet {
    position: absolute;
    z-index: 6;
    top: clamp(0.55rem, 1.1vw, 0.85rem);
    bottom: clamp(0.55rem, 1.1vw, 0.85rem);
    width: calc(50% - clamp(0.55rem, 1.1vw, 0.85rem));
    background: #f2ebd8;
    border: 1px solid rgb(81 57 25 / 12%);
    pointer-events: none;
    transform-style: preserve-3d;
  }

  .turning-sheet::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(83 56 24 / 16%));
    content: "";
    backface-visibility: visible;
  }

  .turning-sheet.forward {
    right: clamp(0.55rem, 1.1vw, 0.85rem);
    animation: turn-forward 1.08s cubic-bezier(.35, .02, .18, 1) both;
    transform-origin: left center;
  }

  .turning-sheet.backward {
    left: clamp(0.55rem, 1.1vw, 0.85rem);
    animation: turn-backward 1.08s cubic-bezier(.35, .02, .18, 1) both;
    transform-origin: right center;
  }

  .book-page {
    position: relative;
    min-width: 0;
    padding: clamp(1.2rem, 3vw, 2.5rem) clamp(1.1rem, 3.2vw, 2.8rem) 2.5rem;
    overflow: hidden;
    background: #f2ebd8;
    color: #171512;
    animation: page-arrives 520ms cubic-bezier(.2, .75, .25, 1) both;
  }

  .book-page:nth-child(2) {
    background: #f2ebd8;
    animation-name: page-arrives-right;
  }

  .book-page:first-child {
    margin-right: -1px;
  }

  .love-page:only-child {
    grid-column: 1 / -1;
  }

  .love-page {
    display: grid;
    place-items: center;
  }

  .love-page p {
    margin: 0;
    color: #a57e38;
    font-family: "Apple Chancery", "Snell Roundhand", cursive;
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 1;
    text-align: center;
    transform: rotate(-3deg);
  }

  .page-heading {
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(0.75rem, 1.5vw, 1.2rem);
    border-bottom: 1px solid rgb(37 29 18 / 22%);
    color: #78603d;
    font-size: clamp(0.48rem, 0.8vw, 0.63rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .book-page h2 {
    margin: clamp(0.9rem, 2vw, 1.6rem) 0 clamp(0.8rem, 1.5vw, 1.25rem);
    font-size: clamp(1.45rem, 3.1vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .book-page ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-page li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: clamp(0.25rem, 0.65vw, 0.48rem) 0;
    font-size: clamp(0.68rem, 1.18vw, 0.9rem);
    letter-spacing: -0.018em;
    line-height: 1.25;
  }

  .book-page li::before {
    flex: 0 0 auto;
    color: #b38639;
    content: "✦";
    font-size: 0.48em;
  }

  .packing-page ul { columns: 2; column-gap: 1.25rem; }
  .packing-page li { break-inside: avoid; }

  .page-flourish {
    position: absolute;
    right: clamp(1rem, 2vw, 2rem);
    bottom: clamp(0.75rem, 1.6vw, 1.25rem);
    color: #a57e38;
    font-family: "Apple Chancery", "Snell Roundhand", cursive;
    font-size: clamp(0.7rem, 1.3vw, 1rem);
    transform: rotate(-3deg);
  }

  .front-cover {
    position: absolute;
    z-index: 7;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 50%;
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    border: 0;
    border-radius: 0.38rem 0.9rem 0.9rem 0.38rem;
    background:
      radial-gradient(circle at 72% 22%, rgb(255 255 255 / 7%), transparent 25%),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 1.5%) 0 1px, transparent 1px 4px),
      #080808;
    color: #f3cb73;
    box-shadow:
      0 1.5rem 4rem rgb(0 0 0 / 62%),
      inset 0 0 0 1px #252525,
      inset 0 0 3rem rgb(0 0 0 / 80%);
    cursor: pointer;
    pointer-events: auto;
    transform: translateZ(0.7rem);
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 1.1s cubic-bezier(.18, .72, .18, 1), opacity 180ms ease;
  }

  .front-cover::before,
  .front-cover::after {
    position: absolute;
    inset: 1rem;
    border: 1px solid rgb(230 179 78 / 70%);
    border-radius: 0.2rem 0.55rem 0.55rem 0.2rem;
    content: "";
  }

  .front-cover::after { inset: 1.35rem; border-color: rgb(230 179 78 / 22%); }

  .front-cover:hover { box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 62%), 0 0 2.8rem rgb(225 169 68 / 22%), inset 0 0 0 1px #292929; }
  .front-cover:focus-visible { outline: 2px solid #f3cb73; outline-offset: 5px; }

  .is-open .front-cover {
    opacity: 0;
    pointer-events: none;
    transform: rotateY(-168deg) translateZ(0.7rem);
    transition: transform 1.1s cubic-bezier(.18, .72, .18, 1), opacity 150ms ease 820ms;
  }

  .cover-kicker {
    font-size: clamp(0.62rem, 1.2vw, 0.92rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .cover-script {
    margin-top: -0.12em;
    color: #e9b853;
    font-family: "Apple Chancery", "Snell Roundhand", cursive;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 1;
    text-shadow: 0 0 1.6rem rgb(235 178 74 / 42%);
    transform: rotate(-4deg);
  }

  .cover-mark { margin: 1.2rem 0; color: #d8a94a; font-size: clamp(0.8rem, 1.5vw, 1.2rem); }

  .cover-date { color: rgb(243 203 115 / 65%); font-size: clamp(0.45rem, 0.75vw, 0.6rem); font-weight: 700; letter-spacing: 0.17em; text-transform: uppercase; }

  .cover-rule { position: absolute; top: 0; bottom: 0; left: 0.62rem; width: 1px; background: linear-gradient(transparent, #c6963e 12% 88%, transparent); }

  .open-instruction,
  .book-controls,
  .shader-credit,
  .close-book {
    position: absolute;
    z-index: 8;
    color: rgb(255 249 235 / 70%);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .open-instruction { right: 1.5rem; bottom: 1.4rem; margin: 0; }
  .open-instruction span { color: #e8b453; }

  .shader-credit { bottom: 1.4rem; left: 1.5rem; text-decoration: none; }
  .shader-credit:hover { color: #fff9eb; }

  .close-book {
    top: 1.4rem;
    right: 1.5rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .book-controls {
    bottom: 1.25rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 1.3rem;
    transform: translateX(-50%);
  }

  .book-controls button {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .book-controls button:hover:not(:disabled) { color: #fff9eb; }
  .book-controls button:disabled { opacity: 0.22; cursor: default; }
  .book-controls span { color: #e8b453; }

  @keyframes page-arrives {
    from { opacity: 0.65; transform: perspective(700px) rotateY(7deg); }
    to { opacity: 1; transform: perspective(700px) rotateY(0deg); }
  }

  @keyframes page-arrives-right {
    from { opacity: 0.65; transform: perspective(700px) rotateY(-7deg); }
    to { opacity: 1; transform: perspective(700px) rotateY(0deg); }
  }

  @keyframes turn-forward {
    0% { transform: perspective(1200px) rotateY(0deg); }
    48% { box-shadow: -1.2rem 0 2rem rgb(41 27 11 / 20%); }
    100% { transform: perspective(1200px) rotateY(-180deg); }
  }

  @keyframes turn-backward {
    0% { transform: perspective(1200px) rotateY(0deg); }
    48% { box-shadow: 1.2rem 0 2rem rgb(41 27 11 / 20%); }
    100% { transform: perspective(1200px) rotateY(180deg); }
  }

  @media (max-width: 700px) {
    .weekend-experience { min-height: 42rem; }
    .experience-title { top: 4.8rem; }
    .experience-title h1 { max-width: 9ch; margin-inline: auto; }
    .is-open .experience-title { display: none; }

    .book-stage { inset: 3.7rem 0 8rem; }
    .book-object { width: min(84vw, 24rem); aspect-ratio: 0.72; transform: rotateX(3deg) rotateZ(-1deg) scale(0.9); }
    .is-open .book-object { transform: rotateX(1deg) scale(1); }
    .book-spread { grid-template-columns: 1fr; transform: scale(0.94); }
    .is-open .book-spread { transform: scale(1); }
    .turning-sheet {
      right: 0.55rem;
      left: 0.55rem;
      width: auto;
    }
    .front-cover { left: 0; width: 100%; }
    .is-open .front-cover { transform: rotateY(-154deg) translateZ(0.7rem); }

    .book-page { padding: 1.45rem 1.35rem 2.6rem; }
    .book-page h2 { font-size: clamp(1.8rem, 9vw, 2.5rem); }
    .book-page li { padding: 0.38rem 0; font-size: clamp(0.72rem, 3.1vw, 0.86rem); }
    .packing-page ul { columns: 2; column-gap: 0.85rem; }
    .packing-page li { font-size: clamp(0.62rem, 2.65vw, 0.76rem); }
    .page-flourish { font-size: 0.78rem; }

    .shader-credit { display: none; }
    .open-instruction { right: 50%; white-space: nowrap; transform: translateX(50%); }
    .book-controls { width: 88%; justify-content: space-between; gap: 0.5rem; }
    .close-book { top: 1.25rem; right: 1.15rem; }
  }

  @media (max-height: 720px) and (min-width: 701px) {
    .experience-title { top: 3.8rem; }
    .book-stage { inset: 5.4rem 0 7.2rem; }
    .book-object { width: min(78vw, 49rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-object,
    .book-spread,
    .front-cover,
    .experience-title { transition-duration: 1ms !important; transition-delay: 0ms !important; }
    .book-page { animation: none; }
  }
</style>
